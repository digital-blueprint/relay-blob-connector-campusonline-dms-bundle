{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "name": "Campusonline DMS API document version information",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": {
      "description": "The version of the document",
      "type": "string"
    },
    "doc_version_metadata": {
      "description": "Additional metadata of the document version",
      "type": "object"
    },
    "doc_metadata": {
      "description": "Additional metadata of the document",
      "type": "object"
    },
    "doc_type": {
      "description": "The CO document type",
      "type": "string"
    }
  },
  "additionalProperties": false
}
